# Copy this into Dokploy → Compose app → Environment tab.
# Replace every <...> before deploying.
# Generate secrets: openssl rand -hex 32

# --- Domains ---
BACKEND_DOMAIN=api.yourdomain.com
STOREFRONT_DOMAIN=store.yourdomain.com

# --- CORS (must match exact origin the browser uses, including protocol and port) ---
# HTTPS + domain example:
# STORE_CORS=https://store.yourdomain.com
# ADMIN_CORS=https://api.yourdomain.com
# AUTH_CORS=https://store.yourdomain.com,https://api.yourdomain.com
# HTTP + IP example (dev/LAN):
STORE_CORS=http://100.70.199.52:8017
ADMIN_CORS=http://100.70.199.52:9017
AUTH_CORS=http://100.70.199.52:8017,http://100.70.199.52:9017

# --- Secrets ---
POSTGRES_PASSWORD=change_me_use_openssl_rand_hex_32
JWT_SECRET=change_me_use_openssl_rand_hex_32
COOKIE_SECRET=change_me_use_openssl_rand_hex_32
REVALIDATE_SECRET=change_me_use_openssl_rand_hex_32

# --- Ports (optional — defaults shown) ---
BACKEND_PORT=9000
STOREFRONT_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Admin ---
# Full URL the browser uses to reach the backend (same as ADMIN_CORS origin)
MEDUSA_BACKEND_URL=http://100.70.199.52:9017
MEDUSA_ADMIN_EMAIL=admin@yourdomain.com
MEDUSA_ADMIN_PASSWORD=change_me_strong_password

# --- Storefront config ---
NEXT_PUBLIC_DEFAULT_REGION=us

# Phase 1: leave as placeholder. Phase 2: replace with real key from Medusa admin.
# Settings → Publishable API Keys → create key → copy pk_... value
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_placeholder

# --- Profiles ---
# Phase 1: leave commented out (storefront disabled).
# Phase 2: uncomment to enable storefront service.
# COMPOSE_PROFILES=storefront
